# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Server-only (draft preview + revalidation)
SANITY_API_READ_TOKEN=
SANITY_REVALIDATE_SECRET=

# Contact form (Resend)
RESEND_API_KEY=
CONTACT_EMAIL=contato@arcadia.com.br

# Site URL (production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Preview mode: uses mock content when Sanity is not configured yet
# Auto-enabled when NEXT_PUBLIC_SANITY_PROJECT_ID is "placeholder"
NEXT_PUBLIC_PREVIEW_MODE=true
